#!/usr/bin/env bash

shopt -s globstar nullglob

DEBUG="-fsanitize=address,undefined -fno-omit-frame-pointer -O0 -g"
RELEASE="-O3 -ffast-math -march=haswell"
: "${CC:=bear -a -o build/compile_commands.json -- gcc}"
: "${CFLAGS:= -I. -Wall -Wextra -Wpedantic -std=c11 -save-temps=obj -fverbose-asm $RELEASE}"
mkdir -p build
for f in src/**/*.c; do
    path="build/obj/"${f%.c}".o"
    mkdir -p "$(dirname "$path")"
    $CC $CFLAGS -c $f -o $path
done
