# ignore everything
*

# un-ignore directories (must be explicit for nested files to work)
!src/
!src/*/
!src/*/*/
!include/
!assets/
!apps/
!tests/
!vendor/

# un-ignore file types
!*.c
!*.h
!*.inl
!*.slang
!*.vert
!*.frag
!*.md
!*.sh
!compile_flags.txt
!*.clang-format
!*.clangd

# ignore 
.cache/
